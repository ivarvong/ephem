{
  "name": "ephem",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-web.ts",
    "dev": "EPHEM_VITE=1 node --experimental-strip-types packages/worker/src/dev.ts",
    "format": "scripts/format.sh",
    "format:check": "scripts/format.sh --check",
    "golden:record": "GOLDEN_RECORD=1 vitest run packages/worker/test/golden.test.ts",
    "test": "node --experimental-strip-types scripts/build-web.ts --if-stale && vitest run",
    "lint": "oxlint packages",
    "typecheck": "node --experimental-strip-types scripts/build-web.ts --if-stale && tsc -p packages/core && tsc -p packages/api && tsc -p packages/web && tsc -p packages/worker && tsc -p packages/tail && tsc -p packages/load"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "^3.23.2",
    "oxlint": "^1.88.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
